{
  "name": "mindmesh-monorepo",
  "version": "1.0.0",
  "description": "MindMesh - Knowledge Intelligence Platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build:shared": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
